# Copy only the variables needed by your installation into the existing
# .env.dev and/or .env.prod. Do not replace those files; they also contain
# NoneBot and OneBot runtime settings.

# Main LLM
OPENAI_API_KEY=
# Optional if different from data/persona/persona.yaml
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# Image understanding: the generic key is the primary provider.
IMAGE_UNDERSTANDING_API_KEY=
# Optional additional providers use their YAML provider name, uppercased:
# IMAGE_UNDERSTANDING_BACKUP_API_KEY=

# Image generation (OpenAI-compatible Images API). If omitted, the
# image-understanding key above is reused when both services share credentials.
# IMAGE_GENERATION_ENABLED=true
# IMAGE_GENERATION_API_KEY=
# IMAGE_GENERATION_BASE_URL=https://openrouter.ai/api/v1
# IMAGE_GENERATION_MODEL=qwen/qwen-image-3-pro
# IMAGE_GENERATION_ENDPOINT_PATH=/images/generations
# Optional reference-guided generation for the configured persona. The
# reference endpoint must support standard multipart image edits.
# IMAGE_GENERATION_REFERENCE_ENDPOINT_PATH=/images/edits
# IMAGE_GENERATION_REFERENCE_IMAGES=["data/persona/references/character-1.png"]
# IMAGE_GENERATION_TIMEOUT_SECONDS=120
# IMAGE_GENERATION_MAX_RETRIES=1

# Database credentials (only needed by the matching backend)
NEO4J_PASSWORD=
POSTGRES_PASSWORD=

# Optional integrations
AMAP_WEATHER_API_KEY=
ALAPI_API_KEY=
ITAD_API_KEY=
